<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_PMDOWNLOADS</name>
    <author>Ponto Mega</author>
    <creationDate>2026-11</creationDate>
    <copyright>(C) 2026 Ponto Mega. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>contato@pontomega.com.br</authorEmail>
    <authorUrl>https://pontomega.com.br</authorUrl>
    <version>1.0.0</version>
    <description>MOD_PMDOWNLOADS_XML_DESCRIPTION</description>
    <namespace path="src">PontoMega\Module\Pmdownloads</namespace>

    <files>
        <folder module="mod_pmdownloads">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <languages folder="language">
        <language tag="pt-BR">pt-BR/mod_pmdownloads.ini</language>
        <language tag="pt-BR">pt-BR/mod_pmdownloads.sys.ini</language>
        <language tag="en-GB">en-GB/mod_pmdownloads.ini</language>
        <language tag="en-GB">en-GB/mod_pmdownloads.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field name="mode" type="list" label="MOD_PMDOWNLOADS_FIELD_MODE_LABEL" default="featured">
                    <option value="featured">MOD_PMDOWNLOADS_MODE_FEATURED</option>
                    <option value="downloads">MOD_PMDOWNLOADS_MODE_DOWNLOADS</option>
                    <option value="recent">MOD_PMDOWNLOADS_MODE_RECENT</option>
                    <option value="hits">MOD_PMDOWNLOADS_MODE_HITS</option>
                </field>
                <field name="status_filter" type="list" label="MOD_PMDOWNLOADS_FIELD_STATUS_LABEL" default="active">
                    <option value="">JALL</option>
                    <option value="active">MOD_PMDOWNLOADS_STATUS_ACTIVE</option>
                    <option value="legacy">MOD_PMDOWNLOADS_STATUS_LEGACY</option>
                </field>
                <field name="count" type="number" label="MOD_PMDOWNLOADS_FIELD_COUNT_LABEL" default="4" min="1" max="12" />
                <field name="catid" type="category" extension="com_pmdownloads" label="JCATEGORY" layout="joomla.form.field.list-fancy-select">
                    <option value="0">JALL</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" />
                <field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="2" validate="CssIdentifier" />
                <field name="cache" type="list" label="COM_MODULES_FIELD_CACHING_LABEL" default="1">
                    <option value="1">JGLOBAL_USE_GLOBAL</option>
                    <option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
